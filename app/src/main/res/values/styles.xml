<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base theme: shared by every API level. Contains only attributes
        that exist on minSdk (24) and up. The actual `AppTheme` name is
        left as an empty inheritor here so the manifest can keep
        referencing @style/AppTheme, and the API-31+ overlay in
        values-v31/styles.xml can re-declare the same `AppTheme` name
        with the extra SplashScreen attributes on top of this base.
    -->
    <style name="AppTheme.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FF1B23</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- AppTheme on pre-API-31 devices: just the base, no SplashScreen attrs. -->
    <style name="AppTheme" parent="@style/AppTheme.Base" />

</resources>

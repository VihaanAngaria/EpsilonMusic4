<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully transparent 1x1 vector drawable used as the Android 12+
    SplashScreen animated icon. Pointing windowSplashScreenAnimatedIcon
    at this drawable means the system splash draws nothing inside its
    circular window -- combined with windowSplashScreenBackground=#000000
    the entire system splash is visually a black screen that hands off
    seamlessly to our video splash in SplashActivity.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path android:pathData="M0,0 L1,0 L1,1 L0,1 Z" />
</vector>

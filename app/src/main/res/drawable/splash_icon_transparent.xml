<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully transparent 108dp vector drawable used as the Android 12+
    SplashScreen animated icon.

    Pointing android:windowSplashScreenAnimatedIcon at this drawable
    means the system splash draws nothing inside its circular window.
    Combined with windowSplashScreenBackground=#000000 the entire
    system splash is visually a black screen that hands off seamlessly
    to the video splash in SplashActivity.

    108dp viewport matches the SplashScreen API's expected icon canvas
    size (the same dimension adaptive icons use); the path simply
    paints a transparent rectangle so nothing is visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#00000000" />
</vector>
